# ─── FlatClaw — operator / local environment ──────────────────────────────
#
# Copy to `.env.local` (gitignored). Local development + operator scripts only.
# Production services get their environment from Northflank's secret manager,
# not this file.
#
# This is the single env reference. The Next.js portal reads its env from
# portal/.env.local — copy the "Portal" section below into that file. The
# operator/lane scripts source the repo-root .env.local.

# ─── OpenClaw gateway ──────────────────────────────────────────────────────
# Gateway WebSocket. Local: a locally-running OpenClaw on port 18789.
# Production: the OpenClaw Gateway Northflank service URL.
NEXT_PUBLIC_GATEWAY_URL=ws://127.0.0.1:18789

# ─── Portal (copy into portal/.env.local) ──────────────────────────────────
# Auth.js session encryption + credential-vault key.
# Generate each: openssl rand -base64 32
AUTH_SECRET=generate-a-random-32-byte-secret
PORTAL_SECRETS_KEY=generate-a-random-32-byte-secret
# Bootstrap admin (created on first boot if no admin exists).
PORTAL_ADMIN_EMAIL=admin@example.com
PORTAL_ADMIN_PASSWORD=change-me
# Gateway RPC + the portal's own base URL (the capability-token bridge the
# per-user MCP servers call back into).
PORTAL_GATEWAY_URL=ws://127.0.0.1:18789
NEXT_PUBLIC_PORTAL_BASE_URL=http://127.0.0.1:3000
# Inference lane: dev | prod (lane scripts stamp the matching URL/model pair).
FLATCLAW_LANE=dev

# ─── Inference lanes (stamped by the lane scripts) ─────────────────────────
# infra/scripts/{dev,prod}-up.sh write these into .env.local after the box is
# up and SGLang is serving. You normally don't set them by hand.
#   DEV_INFERENCE_URL=https://<your-dev-inference-host>/v1
#   DEV_MODEL_ID=gemma-4-e4b-it
#   PROD_INFERENCE_URL=https://<your-prod-inference-host>/v1
#   PROD_MODEL_ID=gemma-4-31b-it

# ─── Inference image (entrypoint.sh defaults) ──────────────────────────────
# Sensible defaults baked into the image. Override only when running the
# inference image manually for local testing. Prod serves Gemma 4 31B-IT at
# its native 256K window.
# MODEL_DIR=/workspace/models
# GEMMA_DIR_NAME=gemma-4-31B-it
# PORT=8000
# MAX_CONTEXT=262144
# TP=1
# SGLANG_EXTRA_ARGS=--kv-cache-dtype fp8_e5m2 --max-running-requests 1

# ─── MCP service integrations ──────────────────────────────────────────────
# Each managed MCP service is enabled by pointing its *_MCP_ENTRY at the built
# server entrypoint (run `npm run build` in the service's mcp/public/<svc>/
# dir). A service whose ENTRY is unset simply isn't offered in the Portal —
# the Portal builds and runs fine with any subset present. Private add-on
# services live under mcp/private/ (gitignored) and self-register the same way.
#
# *_MCP_MODE and *_MCP_TOOLSET are optional per-service knobs (default: full
# toolset, standard mode).
FLATCLAW_JIRA_MCP_ENTRY=/abs/path/to/FlatClaw/mcp/public/jira/build/index.js
# FLATCLAW_JIRA_MCP_MODE=
# FLATCLAW_JIRA_MCP_TOOLSET=
FLATCLAW_GOOGLE_MCP_ENTRY=/abs/path/to/FlatClaw/mcp/public/google/build/index.js
# FLATCLAW_GOOGLE_MCP_MODE=
# FLATCLAW_GOOGLE_MCP_TOOLSET=
#
# Human-approval gating (comma-separated tool lists). Tools listed here are
# COMPOSED by the agent and pause in the Portal approvals queue for human
# sign-off; the portal replays the request with the user's own credentials on
# approve. Empty string = nothing gated. Defaults shown.
# FLATCLAW_JIRA_APPROVAL_TOOLS=delete_attachment
# FLATCLAW_GOOGLE_APPROVAL_TOOLS=gmail_send,gmail_send_draft,drive_delete,drive_share
#
# Per-user service credentials (Jira API token, Google OAuth, etc.) are
# NOT set here — users supply them in the Portal and they're stored in the
# per-(tenant, user, service) credential vault, injected into the MCP process
# at provision time.

# ─── Operator credentials (NEVER COMMIT — .env.local only) ─────────────────
# Used by infra/scripts/{provision-tenant,dev-up,prod-up}.sh to bring up and
# manage tenants + inference. Not read by any deployed service.
#
# NORTHFLANK_API_TOKEN=nf-...
